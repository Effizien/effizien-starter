{
  "name": "effizien-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "tokens": "node tokens/build.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "install:all": "pnpm install && pnpm --dir studio install",
    "studio": "pnpm --dir studio dev",
    "studio:build": "pnpm --dir studio build",
    "studio:deploy": "pnpm --dir studio deploy",
    "typegen": "pnpm --dir studio typegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test",
    "test:a11y:ui": "playwright test --ui",
    "test:perf": "pnpm build && lhci autorun"
  },
  "dependencies": {
    "@portabletext/react": "8.0.0",
    "@sanity/client": "7.26.2",
    "@sanity/image-url": "2.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "next-sanity": "13.3.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.16.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.7",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "8.5.26",
    "style-dictionary": "5.5.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
