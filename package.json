{
  "name": "effizien-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "install:all": "pnpm install && pnpm --dir studio install",
    "studio": "pnpm --dir studio dev",
    "studio:build": "pnpm --dir studio build",
    "studio:deploy": "pnpm --dir studio deploy",
    "typegen": "pnpm --dir studio typegen"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@sanity/client": "7.26.2",
    "@sanity/image-url": "2.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next-sanity": "13.3.1",
    "radix-ui": "1.6.7",
    "shadcn": "4.16.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
