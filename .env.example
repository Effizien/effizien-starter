# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
# NEVER put a real credential in THIS file. It is committed, and a secret here is
# a secret in git history — which is not fixed by deleting it later, only by
# rotating it at the vendor. The secret-scanning hook in .claude/hooks/ blocks
# the obvious cases, but it is a speed bump, not a boundary.


# ── Public. Safe in the browser bundle. ──────────────────────────────────────
# Sanity's docs are explicit that project ID and dataset are not sensitive —
# they are visible in every API request the frontend makes. Find both at
# https://www.sanity.io/manage

NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Pinned date, not floating. Bump deliberately and re-test queries when you do.
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01

# Absolute site URL. Used for canonical, Open Graph and Twitter URLs — without
# it Next emits relative URLs that social scrapers resolve incorrectly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the standalone Studio is deployed. Defaults to <projectId>.sanity.studio.
NEXT_PUBLIC_SANITY_STUDIO_URL=


# ── Secret. Server only. Never prefix any of these NEXT_PUBLIC_. ─────────────
# Next.js inlines NEXT_PUBLIC_* into the client bundle at build time. A token
# placed there ships to every visitor and cannot be revoked by redeploying —
# only by rotating the credential.

# Sanity read token — MUST be the Viewer role, never Editor or Deploy.
# next-sanity sends this to the browser in draft mode so an authenticated editor
# can see unpublished content. That is safe for a Viewer token and a serious
# problem for a write-capable one.
# Create at https://www.sanity.io/manage → API → Tokens
SANITY_API_READ_TOKEN=

# Shared secret for GROQ-powered revalidation webhooks (WP5).
SANITY_REVALIDATE_SECRET=


# ── Studio ───────────────────────────────────────────────────────────────────
# The Studio is a separate app in studio/ with its own env file. Copy these into
# studio/.env.local. SANITY_STUDIO_ is the only prefix the Sanity CLI injects
# into the Studio bundle, so treat every one of them as public.
#
#   SANITY_STUDIO_PROJECT_ID=your-project-id
#   SANITY_STUDIO_DATASET=production
#   SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
