# ---------------------------------------------------------------------------
# effizien-starter
#
# Secrets first, deliberately. This file is the last line of defence between an
# API token and a public GitHub repo, and it is committed before any dependency
# or scaffold so there is never a window where it is absent.
# ---------------------------------------------------------------------------

# Environment / secrets
# .env.example is the only env file that may ever be committed. It contains
# variable NAMES and placeholder values only — never a real credential.
.env
.env.*
!.env.example

# Sanity CLI writes an auth token here
.sanity/
sanity-cli-auth.json

# Claude Code local overrides — machine-specific paths, extra directories,
# per-operator permissions. Never travels with the repo.
.claude/settings.local.json

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
next-env.d.ts

# Production build
/build
/dist

# Vercel
.vercel

# Testing / QA output
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
/.lighthouseci/

# TypeScript
*.tsbuildinfo

# Sanity TypeGen artefacts are generated, not authored
# (schema extract is regenerated by `pnpm typegen`)
schema.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / OS
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
