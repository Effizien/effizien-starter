# Exact versions on `pnpm add`, matching the pinned deps in package.json.
# A starter that drifts between client sites is the drift problem we designed
# against — a lockfile alone doesn't stop `pnpm add` writing a caret range.
save-exact=true

# Fail fast if the running Node doesn't satisfy `engines`, rather than
# producing a confusing runtime error three steps later.
engine-strict=true
